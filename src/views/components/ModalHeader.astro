---
interface Props {
    title: string
}

const { title } = Astro.props;
---
<header class="flex items-center justify-between border-b border-neutral-800 px-6 py-4">
    <h2 class="text-lg font-semibold">
        { title }
    </h2>
    <button type="button" data-close class="rounded-md p-1.5 text-neutral-400 transition hover:bg-neutral-800 hover:text-neutral-100" aria-label="Close">
        <i class="fa-solid fa-xmark"></i>
    </button>
</header>

<script>
    const closeButton = document.querySelector("[data-close]") as HTMLButtonElement;
    closeButton.addEventListener("click", () => {
        const modal = closeButton.closest("dialog");
        if (modal) modal.close();
    });
</script>